{
  "name": "XxxTheSpire",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    // Anthropic 公式 devcontainer feature でClaude Code CLIを導入（npm直接インストールより推奨）
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    // GitHub CLI（gh コマンド）を導入してコンテナ上からIssue取得・操作を可能にする
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // feature が root でインストールした npm global ディレクトリの owner を node に変更
  // → claude の auto-update が node ユーザー権限で成功するようになる
  "postCreateCommand": "sudo chown -R node:node $(npm config get prefix)/lib/node_modules $(npm config get prefix)/bin && npm install",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    }
  },
  // ホストの環境変数・メモリをコンテナに引き継ぐ
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  "mounts": [
    // ~/.claude をマウントしてClaudeのメモリ・設定を永続化（コンテナユーザーは node → /home/node）
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached",
    // ~/.claude.json（メイン設定ファイル）も別途マウント（事前に touch ~/.claude.json が必要）
    "source=${localEnv:HOME}/.claude.json,target=/home/node/.claude.json,type=bind,consistency=cached",
    // gh の認証情報をマウント（GH_TOKEN 不要・ホストの gh auth login セッションをそのまま利用）
    "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "Anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "eamodio.gitlens",
        "usernamehw.errorlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
